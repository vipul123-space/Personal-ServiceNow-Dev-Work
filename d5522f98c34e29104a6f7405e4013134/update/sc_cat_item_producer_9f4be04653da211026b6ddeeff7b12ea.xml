        <script><![CDATA[                  var rpId = RP.getParameterValue('sysparm_id');
var legalRequestWrapper = new sn_lg_ops.LegalRequestWrapper(current, rpId, producer.lg_subcategory);
legalRequestWrapper.setRequestedFor(producer.requested_for);

if (producer.company == 'not-listed' && !gs.nil(producer.new_company_legal_name))
	current.company_legal_name = producer.new_company_legal_name;
else
	current.company_legal_name = current.company.name;

legalRequestWrapper.setShortDescription(producer.contract_type.getDisplayValue()+ " for " + current.company_legal_name);

current.country = producer.country;
current.contract_value.setValue(producer.currency + ";" + producer.contract_value);]]></script>
